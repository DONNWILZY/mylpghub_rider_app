{
  "expo": {
    "name": "MyQuickGas Rider",
    "slug": "myquickgas-rider",
    "scheme": "myquickgas-rider",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand-mark.png",
          "imageWidth": 118,
          "resizeMode": "contain",
          "backgroundColor": "#F0FDF4"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow MyQuickGas Rider to show your location and share it during an active delivery when you ask.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "site.mylpg.rider",
      "supportsTablet": true
    },
    "android": {
      "package": "site.mylpg.rider"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    }
  }
}
